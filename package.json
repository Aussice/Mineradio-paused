{
  "name": "mineradio-visual",
  "productName": "Mineradio Visual",
  "version": "2.2.1",
  "description": "基于 Mineradio 的 Windows 音乐视觉播放器，整合音乐烟花与万花筒工作室。",
  "author": "Mineradio",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:visual && electron-builder --win nsis --publish never",
    "build:win:dir": "npm run build:visual && electron-builder --win dir --publish never",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never",
    "build:visual": "tsc -p visual-studio/tsconfig.app.json --noEmit && vite build --config visual-studio/vite.config.ts",
    "dev:visual": "vite --config visual-studio/vite.config.ts --host 127.0.0.1",
    "prestart": "npm run build:visual",
    "test:visual": "node --test tests/visual-theater-permission.test.js"
  },
  "build": {
    "appId": "com.aussice.mineradio.visual",
    "productName": "Mineradio Visual",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "*-api.js",
      "qishui-auth-v6.js",
      "qishui-qr-login.js",
      "qishui-auth-v6/**/*",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "Mineradio Visual",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio Visual",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/visual-installer.nsh",
      "artifactName": "Mineradio-Visual-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Aussice",
        "repo": "Mineradio-paused"
      }
    ]
  },
  "mineradio": {
    "update": {
      "provider": "github",
      "owner": "Aussice",
      "repo": "Mineradio-paused",
      "preview": false,
      "preferMirrors": false,
      "mirrors": []
    },
    "runtimeName": "Mineradio Visual"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "11.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.61.0",
    "rcedit": "^5.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.0"
  }
}
